filter(ProjectCode == "HC_TU_COM01") %>%
mutate(CollectionDate = as.Date(CollectionDate, tryFormats = "%m/%d/%Y")) %>%
filter(CollectionDate >= as.Date("2016-01-01") & CollectionDate <= as.Date("2019-12-31")) %>%
mutate(
SalmonellaSpAnalysis = factor(SalmonellaSpAnalysis),
SalmonellaSerotype = ifelse(SalmonellaSerotype == "NULL", NA, SalmonellaSerotype),
SalmonellaSerotype = factor(SalmonellaSerotype),
SalmonellaMPNg = ifelse(SalmonellaMPNg == "NULL", NA, SalmonellaMPNg),
SalmonellaMPNg = ifelse(SalmonellaMPNg == "<0.03; <0.03", "<0.03", SalmonellaMPNg),
SalmonellaMPNcombo = ifelse(SalmonellaMPNcombo=="00000; 00000", "00000", SalmonellaMPNcombo),
SalmonellaMPNqual = ifelse(SalmonellaMPNqual=="Negative; Negative", "Negative", SalmonellaMPNqual),
value_type = case_when(
grepl("<", SalmonellaMPNg) ~ "cutoff_left",
grepl(">", SalmonellaMPNg) ~ "cutoff_right",
!is.na(SalmonellaMPNg) ~ "value",
TRUE ~ NA_character_
),
value_actual = SalmonellaMPNg,
value_actual = gsub("<", "", value_actual),
value_actual = gsub(">", "", value_actual),
value_actual = as.numeric(value_actual),
SalmonellaMPNcombo = str_pad(as.character(SalmonellaMPNcombo), 5, pad = "0"),
SalmonellaMPNqual = na_if(SalmonellaMPNqual, ""),
SalmonellaMPNqual = factor(SalmonellaMPNqual),
SalmonellaMPNcombo_Tube_1 = as.numeric(substr(SalmonellaMPNcombo, 1, 1)),
SalmonellaMPNcombo_Tube_2 = as.numeric(substr(SalmonellaMPNcombo, 2, 2)),
SalmonellaMPNcombo_Tube_3 = as.numeric(substr(SalmonellaMPNcombo, 3, 3)),
SalmonellaMPNcombo_Tube_4 = as.numeric(substr(SalmonellaMPNcombo, 4, 4)),
SalmonellaMPNcombo_Tube_5 = as.numeric(substr(SalmonellaMPNcombo, 5, 5))
) %>%
filter(SalmonellaSpAnalysis == "Positive"| SalmonellaSpAnalysis == "Negative")
n_total <- nrow(fsis_haccp_turkey_2021)
n_pos_test <- nrow(fsis_haccp_turkey_2021[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis == "Positive"),])
n_pos_test_mpn <- nrow(fsis_haccp_turkey_2021[which(fsis_haccp_turkey_2021$SalmonellaMPNqual == "Positive"),])
nrow(fsis_haccp_turkey_2021)
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Negative")])
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive")])
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive" & fsis_haccp_turkey_2021$value_actual > 1 & fsis_haccp_turkey_2021$value_type=="value")])
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive" & fsis_haccp_turkey_2021$value_actual > 10 & fsis_haccp_turkey_2021$value_type=="value")])
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Negative")])/nrow(fsis_haccp_turkey_2021)
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive")])/nrow(fsis_haccp_turkey_2021)
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive" & fsis_haccp_turkey_2021$value_actual > 1 & fsis_haccp_turkey_2021$value_type=="value")])/nrow(fsis_haccp_turkey_2021)
length(fsis_haccp_turkey_2021$SalmonellaSpAnalysis[which(fsis_haccp_turkey_2021$SalmonellaSpAnalysis=="Positive" & fsis_haccp_turkey_2021$value_actual > 10 & fsis_haccp_turkey_2021$value_type=="value")])/nrow(fsis_haccp_turkey_2021)
# Drop sal_mpn_tubes NAs for MPN fitting
subset_data <- fsis_haccp_turkey_2021[which(fsis_haccp_turkey_2021$SalmonellaMPNqual == "Positive"),] %>%
select(SalmonellaMPNcombo_Tube_1, SalmonellaMPNcombo_Tube_2, SalmonellaMPNcombo_Tube_3, SalmonellaMPNcombo_Tube_4, SalmonellaMPNcombo_Tube_5)
mpn_fit(mpn_data = subset_data, n_total, n_pos_test ,n_pos_test_mpn, n_tubes = 3, type = "ground")
### Outputs and Summary:
(SummaryResults=summary(window(zm1, start = burn.in), quantiles=c(0.025, 0.5, 0.975)))
mu=    c(window(zm1[[1]][,1],start=burn.in),
window(zm1[[2]][,1],start=burn.in),
window(zm1[[3]][,1],start=burn.in))
tau=   c(window(zm1[[1]][,2],start=burn.in),
window(zm1[[2]][,2],start=burn.in),
window(zm1[[3]][,2],start=burn.in))
sigma= sqrt(1/tau)
# Summarizing coda object:
summary(zm1)  # print(zm1)  to visualize the entire output
summary(tau)
#plot(zm1)
traceplot(zm1)
# Test for convergence:
heidel.diag(zm1)
### Plots and outputs:
summary_stats<-as.data.frame(cbind(stat.desc(mu),stat.desc(sigma)))
names(summary_stats)<-c("mu","sigma")
summary_stats$mu_log10 <- log10(exp(summary_stats$mu))
summary_stats$sigma_log10 <- log10(exp(summary_stats$sigma))
write.csv(summary_stats,"JAGS_Fit_Summary.csv")
summary_stats
# Plot density functions:
mu<-as.matrix(sort(mu))
K.ecdf<-ecdf(mu)
par(mfrow=c(1,1),mar=c(3,3,2,2), las=1)
plot(density(mu), main="mu")
log_mu<-log10(exp(mu))
plot(density(log_mu), main="mu in log10")
abline(v=mean(log_mu), col="blue", lwd = 2, lty = 2)
mean(log_mu)
sigma<-as.matrix(sort(sigma))
K.ecdf<-ecdf(sigma)
plot(density(sigma), main="sigma")
log_sigma<-log10(exp(sigma))
plot(density(log_sigma), main="sigma in log10")
abline(v=mean(log_sigma), col="red", lwd = 2, lty = 2)
mean(log_sigma)
par(mfrow=c(1,2),mar=c(1,3,2,2), las=1)
boxplot(mu,main="mu",col="lightgreen")
boxplot(sigma,main="sigma",col="yellow")
# Print summary statistics of fitted parameters of the lognormal distribution:
print(summary_stats)
