summary_stats$sigma_log10 <- log10(exp(summary_stats$sigma))
fit <- c(mean(log10(exp(mu))), mean(log10(exp(sigma))))
return(list(fit=fit,summary_stats = summary_stats ))
}
haccp_mpn_fit_2021<-mpn_fit(mpn_data = subset_data, n_total, n_pos_test ,n_pos_test_mpn, n_tubes = 3, type = "ground")
